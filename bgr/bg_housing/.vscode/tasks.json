{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dwelling Lens: start development server",
      "type": "shell",
      "command": "env HOST=0.0.0.0 npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "dwelling-lens",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Commercial API listening",
          "endsPattern": "Network:.*5173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
